<view class="container">
  <view class="title">食材新鲜度检测</view>
  <view class="card">
    <view class="image-placeholder">
      <image wx:if="{{imagePath}}" src="{{imagePath}}" mode="aspectFit" style="width:100%;height:100%;border-radius:12rpx;" />
      <text wx:else class="prompt">拍照或从相册选择食材图片</text>
    </view>
    <view class="button-row">
      <button class="camera-btn" type="primary" bindtap="onOpenCamera">打开相机</button>
      <button class="album-btn" type="default" bindtap="onSelectFromAlbum">从相册选择</button>
    </view>
  </view>
</view> 